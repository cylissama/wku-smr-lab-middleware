// GENERATED by architecture/sync.py from docker-compose.yml. Do not edit:
// change the smr.description label there and rerun `python architecture/sync.py`.

model {
  extend ams {

    mqtt-broker = broker 'mqtt-broker' {
      technology 'eclipse-mosquitto:2, ports MQTT_PORT→1883, 9001'
      description 'MQTT broker. Receives IMU and camera messages from the edge Pis.'
      metadata {
        compose_service 'mqtt-broker'
        container_name 'AMS-mqtt-broker'
        monitor 'true'
        autoheal 'true'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }

    fastapi-app = service 'fastapi-app' {
      technology 'built from Dockerfile, ports FASTAPI_PORT→8000'
      description 'The API behind the dashboard (Python, FastAPI). Owns sessions and the capture mode, ingests MQTT, writes to Postgres in batches, asks stack-controller to deploy the edge, watches the PLC, runs backups.'
      metadata {
        compose_service 'fastapi-app'
        container_name 'AMS-fastapi'
        monitor 'true'
        autoheal 'true'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }

    stack-controller = service 'stack-controller' {
      technology 'built from stack_controller/Dockerfile'
      description 'Deploys and removes whitelisted Swarm stacks (stacks.yml) with only the selected services. Runs the container watchdog and serves read-only /containers and /logs.'
      metadata {
        compose_service 'stack-controller'
        container_name 'AMS-stack-controller'
        monitor 'true'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }

    web = webapp 'web' {
      technology 'built from web/Dockerfile, ports WEB_PORT→80'
      description 'nginx serving the dashboard, the docs and the architecture site. Proxies /api/ to fastapi-app, and /api/system/containers and /api/system/logs to stack-controller.'
      metadata {
        compose_service 'web'
        container_name 'AMS-dashboard-docs'
        monitor 'true'
        autoheal 'true'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }

    tcp = service 'tcp' {
      technology 'built from tcp_server/dockerfile, ports ROBOT_TCP_PORT→5001'
      description 'Robot TCP listener (Python asyncio). Splits the robot stream into CSV lines, applies the capture gate from fastapi-app, batches rows into Postgres. Status server on 8090.'
      metadata {
        compose_service 'tcp'
        container_name 'AMS-tcp-listener'
        monitor 'true'
        autoheal 'true'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }

    ntp = service 'ntp' {
      technology 'cturra/ntp:latest, ports NTP_PORT→123/udp'
      description 'NTP server synced from the Google public pool; the lab\'s shared clock.'
      metadata {
        compose_service 'ntp'
        container_name 'AMS-ntp'
        monitor 'true'
        autoheal 'true'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }

    postgres = database 'postgres' {
      #optional
      technology 'postgres:16-alpine, ports 5432'
      description 'Bundled Postgres, only with the local-db profile, for running away from the NAS. Not used in the lab.'
      metadata {
        compose_service 'postgres'
        container_name 'AMS-postgres'
        compose_profile 'local-db'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }

    pgadmin = webapp 'pgadmin' {
      technology 'dpage/pgadmin4:9, ports 5050→80'
      description 'pgAdmin with one account per person, each tied to its own Postgres role (lab_viewers or lab_admins).'
      metadata {
        compose_service 'pgadmin'
        container_name 'AMS-pgadmin'
        monitor 'true'
        autoheal 'true'
      }
      link https://github.com/cylissama/wku-smr-lab-middleware/blob/main/docker-compose.yml 'docker-compose.yml'
    }
  }
}
