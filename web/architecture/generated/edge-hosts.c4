// GENERATED by architecture/sync.py from deploy/swarm-edge-nodes.yml (hostnames and ids from deploy/.env.example). Do not edit:
// change the smr.description label there and rerun `python architecture/sync.py`.

deployment {
  swarm edgepis 'Edge Pis (Swarm workers)' {
    description 'One Pi per edge service, placed by hostname or node label. Addresses are in the docs IP table.'

    host rpiimuj1 'RPIIMUJ1' {
      technology 'edge_imu-106, device imu/106'
      description 'Placement: node.hostname == RPIIMUJ1'
      imu-106 = instanceOf edge.imuNode {
        title 'imu-106 (imu/106)'
        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host rpiimuj2 'RPIIMUJ2' {
      technology 'edge_imu-107, device imu/107'
      description 'Placement: node.hostname == RPIIMUJ2'
      imu-107 = instanceOf edge.imuNode {
        title 'imu-107 (imu/107)'
        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host rpiimuj3 'RPIIMUJ3' {
      technology 'edge_imu-108, device imu/108'
      description 'Placement: node.hostname == RPIIMUJ3'
      imu-108 = instanceOf edge.imuNode {
        title 'imu-108 (imu/108)'
        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host rpiimuj4 'RPIIMUJ4' {
      technology 'edge_imu-109, device imu/109'
      description 'Placement: node.hostname == RPIIMUJ4'
      imu-109 = instanceOf edge.imuNode {
        title 'imu-109 (imu/109)'
        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host rpiimuj5 'RPIIMUJ5' {
      technology 'edge_imu-110, device imu/110'
      description 'Placement: node.hostname == RPIIMUJ5'
      imu-110 = instanceOf edge.imuNode {
        title 'imu-110 (imu/110)'
        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host rpi-imu-bench 'RPI-IMU-BENCH' {
      technology 'edge_imu-111, device imu/111'
      description 'Placement: node.hostname == RPI-IMU-BENCH'
      imu-111 = instanceOf edge.imuNode {
        title 'imu-111 (imu/111)'
        description 'Bench IMU node (RPI-IMU-BENCH). imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host camera-front-pi 'Pi with label camera=front' {
      technology 'edge_camera-front, device camera/113_front'
      description 'Placement: node.labels.camera == front'
      camera-front = instanceOf edge.cameraNode {
        title 'camera-front (camera/113_front)'
        description 'Front camera. camera_edge detects ArUco markers and publishes each frame\'s marker poses to camera/<device id>_front.'
      }
    }

    host camera-side-pi 'Pi with label camera=side' {
      technology 'edge_camera-side, device camera/114_side'
      description 'Placement: node.labels.camera == side'
      camera-side = instanceOf edge.cameraNode {
        title 'camera-side (camera/114_side)'
        description 'Side camera. camera_edge detects ArUco markers and publishes each frame\'s marker poses to camera/<device id>_side.'
      }
    }
  }
}
