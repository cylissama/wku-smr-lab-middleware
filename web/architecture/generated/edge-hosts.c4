        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host rpiimuj5 'RPIIMUJ5' {
      technology 'edge_imu-110, device imu/110'
      description 'Placement: node.hostname == RPIIMUJ5'
      imu-110 = instanceOf edge.imuNode {
        title 'imu-110 (imu/110)'
        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host rpiimuj6 'RPIIMUJ6' {
      technology 'edge_imu-111, device imu/111'
      description 'Placement: node.hostname == RPIIMUJ6'
      imu-111 = instanceOf edge.imuNode {
        title 'imu-111 (imu/111)'
        description 'IMU node. imu_edge reads the Pi\'s IMU through imu_host and publishes each sample to imu/<device id>; when recording it waits for the PLC\'s Data_Start.'
      }
    }

    host camera-cam1-pi 'Pi with label camera=cam1' {
      technology 'edge_camera-cam1, device camera/114_cam1'
      description 'Placement: node.labels.camera == cam1'
      camera-cam1 = instanceOf edge.cameraNode {
        title 'camera-cam1 (camera/114_cam1)'
        description 'Camera 1 (RPICAM1). camera_edge takes frames from camera_host and forwards each JPEG to camera-processor on the AMS, which publishes the marker poses to camera/<device id>_cam1. When recording it waits for the PLC\'s Data_Start.'
      }
    }

    host camera-cam2-pi 'Pi with label camera=cam2' {
      technology 'edge_camera-cam2, device camera/113_cam2'
      description 'Placement: node.labels.camera == cam2'
      camera-cam2 = instanceOf edge.cameraNode {
        title 'camera-cam2 (camera/113_cam2)'
        description 'Camera 2 (RPICAM2). camera_edge takes frames from camera_host and forwards each JPEG to camera-processor on the AMS, which publishes the marker poses to camera/<device id>_cam2. When recording it waits for the PLC\'s Data_Start.'
