# Template for .env — copy this file to .env and fill in real
# values. .env itself is gitignored; this example file is safe to commit since
# every value below is a placeholder.
#
# Two ways to run this stack, see web/docs/docker/compose.md:
#   1. Lab deployment (docker-compose.yml)        -> DB_HOST/DB_PORT point at the NAS
#   2. Portable/local test (docker-compose.local.yml) -> bundled Postgres, DB_HOST is
#      overridden inside that file, but DB_USER/DB_PASSWORD/DB_NAME below still apply
#
# docker-compose.yml also supports `--profile local-db` to add a bundled
# Postgres alongside the lab stack; if you use that, set
# DB_HOST=postgres and DB_PORT=5432 below instead of the NAS values.

# --- Database ---
# Lab: DB_HOST is the NAS's LAN IP, e.g. 192.168.2.50
# Local/portable: DB_HOST=postgres, DB_PORT=5432 (matches the bundled postgres service)
DB_HOST=192.0.2.10
DB_PORT=5432
DB_USER=ams_app
DB_PASSWORD=change-me
DB_NAME=ams

# PGPORT is read by some tooling in addition to DB_PORT above; keep them equal
PGPORT=5432

# --- pgAdmin (always-on `pgadmin` service, multi-user server mode) ---
# EMAIL/PASSWORD are the initial admin account, applied only on first start
# against an empty pgadmin_data volume. Student accounts are created with
# pgadmin/provision-users.sh, see web/docs/data/accessing-database.md.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050
# gunicorn threads for pgAdmin's single worker (image default is 25)
PGADMIN_THREADS=50

# --- Networking ---
# HOST_IP is the LAN IP of the machine running docker compose (Data Broker Mini
# PC in the lab; your own machine's IP for local/portable testing)
HOST_IP=192.0.2.100
MQTT_PORT=1883
FASTAPI_PORT=8000
WEB_PORT=8080
ROBOT_TCP_PORT=5001
NTP_PORT=123

# --- Batching tunables (fast_server / tcp_server ingestion workers) ---
QUEUE_SIZE=1000
BATCHES=100
B_TIMEOUT=2

# --- Frontend build args (baked into the Vite bundle at build time) ---
# Leave blank to fall back to relative /api, /ws paths via nginx proxy
VITE_API_URL=
VITE_WS_URL=
VITE_AI_URL=
VITE_TWINS_URL=
VITE_ROBOT_CAMERA_URL=
VITE_DB_GUI_URL=
VITE_PORTAINER_URL=

# --- Dashboard "Info" links (external service URLs shown in the SPA) ---
ROBOT_CAMERA_URL=
# Leave blank to default to the bundled pgAdmin at http://${HOST_IP}:${PGADMIN_PORT}
DB_GUI_URL=
PORTAINER_URL=

# --- Stack controller agent (docker.sock-backed Swarm stack deploy/remove) ---
# Bearer token shared between fastapi-app and stack-controller; generate a
# random value (e.g. `openssl rand -hex 32`), never commit the real value.
STACK_CONTROLLER_TOKEN=change-me
# Comma-separated stack names (must match keys in stack_controller/stacks.yml)
# that start_session/stop_session deploy and remove together. "edge" is
# deploy/swarm-edge-nodes.yml (all IMUs + cameras); its per-node values
# (hostnames, device IDs, camera calibration, MQTT broker) live in
# deploy/.env, not here.
MANAGED_STACKS=edge

# --- PLC auto stop (fast_server/plc_listener.py) ---
# The robot cell PLC pulses PLC_TAG_STOP when the robot finishes its move;
# with PLC_AUTO_STOP=true, fastapi-app then stops the recording session the
# same way the dashboard's Stop button does (monitor mode is left alone).
PLC_AUTO_STOP=false
# pycomm3 path: the PLC's IP (L32E), or ip/slot
PLC_PATH=192.168.1.103
PLC_TAG_STOP=Db_Stop
PLC_POLL_S=0.05
# IMU edge nodes wait for the PLC's Data_Start in a recording session
# (IMU_PLC_TRIGGER=true on deploy); monitoring always streams right away.
# false = sessions also stream right away, e.g. recording without the robot.
IMU_PLC_TRIGGER_ON_RECORD=true
# Testing only: replay a fake Db_Stop pulse ~20 s after startup instead of reading the PLC
PLC_FAKE=false
