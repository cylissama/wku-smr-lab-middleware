# Template for deploy/.env -- copy it to deploy/.env on the AMS host. deploy/.env
# is gitignored; this file is committed and has no secrets.
#
# ============================================================================
# EDGE STACK .env  (deploy/, next to swarm-edge-nodes.yml)
# Read by: stack-controller (mounted at /stacks/.env) on every edge deploy,
#          or by your shell for a manual `docker stack deploy` (see below)
# Applies: on the next deploy (monitor start / session start); no recreate
# NOT the broker settings: those are in the repo-root .env (DB, ports,
# PLC_AUTO_STOP, IMU_PLC_TRIGGER_ON_RECORD, ...), read by fastapi-app.
# ============================================================================
# swarm-edge-nodes.yml pulls its values from here via ${VAR}
# interpolation. For a manual deploy, load it into the shell first:
#
#   set -a
#   source ./.env
#   set +a
#   docker stack deploy --resolve-image never -c swarm-edge-nodes.yml edge

# --- Shared across all edge stacks ---
MQTT_BROKER_IP=192.168.2.100
MQTT_BROKER_PORT=1883

# --- IMU: shared defaults ---
IMU_SAMPLE_HZ=100
IMU_REQUEST_TARE=true
IMU_RESET_COUNTER=true
IMU_AUTO_START_SESSION=true
IMU_STOP_SESSION_ON_EXIT=true
IMU_PLC_FAKE=false
# fastapi-app overrides this per deploy: false when monitoring, true for a
# session (see env_overrides in stack_controller/stacks.yml). Only a manual
# `docker stack deploy` uses this value. To make sessions stream without
# waiting for the PLC, set IMU_PLC_TRIGGER_ON_RECORD=false in the repo-root
# .env instead -- not here.
IMU_PLC_TRIGGER=false
# Default for the dashboard's run parameters (as is IMU_SAMPLE_HZ); the
# dashboard overrides them per run.
IMU_PLC_MAX_RUN_S=600
# --- IMU: per-node ---
IMU_106_DEVICE_ID=106
IMU_106_HOSTNAME=RPIIMUJ1
IMU_107_DEVICE_ID=107
IMU_107_HOSTNAME=RPIIMUJ2
IMU_108_DEVICE_ID=108
IMU_108_HOSTNAME=RPIIMUJ3
IMU_109_DEVICE_ID=109
IMU_109_HOSTNAME=RPIIMUJ4
IMU_110_DEVICE_ID=110
IMU_110_HOSTNAME=RPIIMUJ5
IMU_111_DEVICE_ID=111
IMU_111_HOSTNAME=RPI-IMU-BENCH

# --- Camera: shared defaults ---
CAMERA_MARKER_LENGTH_M=0.0485

# --- Camera: per-node (was .env.front / .env.side) ---
CAMERA_FRONT_DEVICE_ID=113
CAMERA_FRONT_NAME=front
CAMERA_FRONT_CALIBRATION_PATH=calib/PLACEHOLDER_front_1920x1080.yml
CAMERA_SIDE_DEVICE_ID=114
CAMERA_SIDE_NAME=side
CAMERA_SIDE_CALIBRATION_PATH=calib/PLACEHOLDER_front_1920x1080.yml

