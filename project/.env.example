# Template for project/.env — copy this file to project/.env and fill in real
# values. .env itself is gitignored; this example file is safe to commit since
# every value below is a placeholder.
#
# Two ways to run this stack, see project/web/docs/docker/compose.md:
#   1. Lab deployment (docker-compose.yml)        -> DB_HOST/DB_PORT point at the NAS
#   2. Portable/local test (docker-compose.local.yml) -> bundled Postgres, DB_HOST is
#      overridden inside that file, but DB_USER/DB_PASSWORD/DB_NAME below still apply
#
# docker-compose.yml also supports `--profile local-db` to add the bundled
# Postgres + pgAdmin alongside the lab stack; if you use that, set
# DB_HOST=postgres and DB_PORT=5432 below instead of the NAS values.

# --- Database ---
# Lab: DB_HOST is the NAS's LAN IP, e.g. 192.168.2.50
# Local/portable: DB_HOST=postgres, DB_PORT=5432 (matches the bundled postgres service)
DB_HOST=192.0.2.10
DB_PORT=5432
DB_USER=ams_app
DB_PASSWORD=change-me
DB_NAME=ams

# PGPORT is read by some tooling in addition to DB_PORT above; keep them equal
PGPORT=5432

# --- pgAdmin (only used with docker-compose.local.yml or --profile local-db) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050

# --- Networking ---
# HOST_IP is the LAN IP of the machine running docker compose (Data Broker Mini
# PC in the lab; your own machine's IP for local/portable testing)
HOST_IP=192.0.2.100
MQTT_PORT=1883
FASTAPI_PORT=8000
WEB_PORT=8080
ROBOT_TCP_PORT=5001
NTP_PORT=123

# --- Batching tunables (fast_server / tcp_server ingestion workers) ---
QUEUE_SIZE=1000
BATCHES=100
B_TIMEOUT=2

# --- Frontend build args (baked into the Vite bundle at build time) ---
# Leave blank to fall back to relative /api, /ws paths via nginx proxy
VITE_API_URL=
VITE_WS_URL=
VITE_AI_URL=
VITE_TWINS_URL=
VITE_ROBOT_CAMERA_URL=
VITE_DB_GUI_URL=
VITE_PORTAINER_URL=

# --- Dashboard "Info" links (external service URLs shown in the SPA) ---
ROBOT_CAMERA_URL=
DB_GUI_URL=
PORTAINER_URL=
